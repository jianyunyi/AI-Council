:80 {
  redir https://{host}{uri} permanent
}

:443 {
  tls {$TLS_CERT} {$TLS_KEY}

  handle /api/* {
    reverse_proxy {$COUNCIL_UPSTREAM:council:8080}
  }

  # Health is public for ingress checks. Metrics stay internal; expose them
  # only through a separate, protected route when external scraping is needed.
  handle /healthz {
    reverse_proxy {$COUNCIL_UPSTREAM:council:8080}
  }

  handle {
    reverse_proxy {$WEB_UPSTREAM:web:3000}
  }
}

FROM golang:1.25 AS build
WORKDIR /src
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=$GOPROXY
COPY . .
RUN CGO_ENABLED=0 go build -o /out/council ./cmd/council-server
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/healthcheck ./cmd/healthcheck
FROM gcr.io/distroless/static-debian12
COPY --from=build /out/council /council
COPY --from=build /out/healthcheck /healthcheck
EXPOSE 8080
ENTRYPOINT ["/council","-listen","0.0.0.0:8080","-db","/app/.data/council.db"]

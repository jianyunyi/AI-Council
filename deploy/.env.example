# Copy this file to deploy/.env. Do not commit deploy/.env.
COUNCIL_BOOTSTRAP_SUBJECT=admin

# Required secrets: supply strong, unique values in deploy/.env or a secret manager.
# COUNCIL_BOOTSTRAP_PASSWORD=
# RUNNER_TOKEN=
# Generate once and retain outside the server: openssl rand -hex 32
# AICOUNCIL_BACKUP_KEY=<64 hex characters; required by Compose>
# Generate once and retain securely. Losing this key makes saved provider credentials unrecoverable.
# PROVIDER_KEY_ENCRYPTION_KEY=<64 hex characters; required to enable per-user Provider Keys>
# Email registration and password reset are disabled until SMTP is configured.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# Set PUBLIC_BASE_URL and at least one OAuth client ID/secret pair to enable OAuth.
# The registered provider callback must be {PUBLIC_BASE_URL}/api/v1/auth/oauth/{github|google}/callback
# PUBLIC_BASE_URL=https://council.example.com
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# To validate the Compose file without adding values here, run:
# powershell -ExecutionPolicy Bypass -File deploy/validate-compose.ps1

# Caddy reads certificate and key paths inside its container. Put the files in
# ./deploy/certs by default, or set TLS_CERT_DIRECTORY to a different host path.
# TLS_CERT=/certs/tls.crt
# TLS_KEY=/certs/tls.key
TLS_CERT_DIRECTORY=./certs

# Host directory mounted into the Runner as /workspace.
# Place or clone each repository under this directory before adding its relative path in the UI.
WORKSPACE_DIRECTORY=../workspaces

COUNCIL_UPSTREAM=council:8080
WEB_UPSTREAM=web:3000

# Go image builds use this domestic module mirror by default. Override only
# when your network requires another proxy.
GOPROXY=https://goproxy.cn,direct

# Optional model-provider credentials and model names.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet

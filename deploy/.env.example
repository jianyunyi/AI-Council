# Copy this file to deploy/.env. Do not commit deploy/.env.
COUNCIL_BOOTSTRAP_SUBJECT=admin

# Required secrets: supply strong, unique values in deploy/.env or a secret manager.
# COUNCIL_BOOTSTRAP_PASSWORD=
# RUNNER_TOKEN=
# To validate the Compose file without adding values here, run:
# powershell -ExecutionPolicy Bypass -File deploy/validate-compose.ps1

# Caddy reads certificate and key paths inside its container. Put the files in
# ./deploy/certs by default, or set TLS_CERT_DIRECTORY to a different host path.
# TLS_CERT=/certs/tls.crt
# TLS_KEY=/certs/tls.key
TLS_CERT_DIRECTORY=./certs

COUNCIL_UPSTREAM=council:8080
WEB_UPSTREAM=web:3000

# Optional model-provider credentials and model names.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet
